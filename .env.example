# ── データベース（Neon PostgreSQL）──
# url=プール接続（アプリ実行時） / directUrl=直結（migrate 用）
POSTGRES_PRISMA_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── セッション署名（openssl rand -hex 32）──
AUTH_SECRET="change-me-to-a-long-random-string"

# ── ブランド ──
NEXT_PUBLIC_APP_NAME="シンカワ"

# ── Claude API（クイック登録の抽出・将来のOCR。未設定なら正規表現フォールバック）──
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
# 領収書の読み取り（既定 claude-sonnet-5-5）と、日報の「AIでまとめる」（既定 claude-haiku-5-5）のモデル。変えるときだけ設定
ANTHROPIC_OCR_MODEL=""
ANTHROPIC_SUMMARY_MODEL=""

# ── Vercel Blob（ローカルは RW トークン。Vercel 上は BLOB_STORE_ID / OIDC で自動）──
BLOB_READ_WRITE_TOKEN=""

# ── Cron 認可（Vercel Cron が Bearer で送る）──
CRON_SECRET=""

# ── Web Push（npx web-push generate-vapid-keys）──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:info@example.com"

# ── シード ──
# 初期データ（デモ用ユーザー）のパスワード。8文字以上。未設定なら初期データを作らない（本番では設定しない）
SEED_PASSWORD=""
# SEED_ONLY_IF_EMPTY=1  # ユーザーが存在すればシードをスキップ（vercel-build で使用）
